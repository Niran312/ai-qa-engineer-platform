# Copy this file to .env and fill in real values. Never commit the real .env.

# OpenRouter API key used for test generation and MCP/behavioral reasoning.
# Can also be supplied per-request from the frontend's "OpenRouter AI Settings" panel;
# this is the server-side default used when a request doesn't provide its own.
OPENROUTER_API_KEY=

# Model used for all AI reasoning. Server-controlled only - never overridable from the frontend.
OPENROUTER_PRIMARY_MODEL=z-ai/glm-5.2:free

# Comma-separated fallback models tried, in order, only if the primary model fails.
# Leave empty (default) to fail with a clear error instead of silently switching models.
OPENROUTER_FALLBACK_MODELS=

# Comma-separated list of origins allowed to call this API (CORS), e.g.:
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Leave unset (or "*") to allow all origins - fine for local development only.
ALLOWED_ORIGINS=*

# Port the server listens on. Render sets this automatically; only needed for local runs
# that don't use the default 8000.
PORT=8000

# Directory where qa_platform.db and static/ (screenshots, downloads, storage_state) live.
# On Render this must match the mountPath of the attached persistent disk (see render.yaml) -
# otherwise scan history and generated Excel files are lost on every redeploy/restart.
# Leave unset for local development (defaults to the backend directory).
DATA_DIR=
