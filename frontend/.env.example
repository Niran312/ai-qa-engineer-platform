# Copy this file to .env and fill in real values. Never commit the real .env.

# Base URL of the deployed backend API, e.g.:
# VITE_API_BASE_URL=https://your-backend.onrender.com
# Leave unset for local development - Vite's dev server proxies /api and /static
# to http://localhost:8000 (see vite.config.js), so requests work without this set.
VITE_API_BASE_URL=
